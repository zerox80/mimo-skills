{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mimo-security-scan/v1/findings.json",
  "title": "mimo-security-scan/v1 findings",
  "type": "object",
  "required": ["format", "findings"],
  "additionalProperties": true,
  "properties": {
    "format": { "const": "mimo-security-scan/v1" },
    "findings": {
      "type": "array",
      "items": { "$ref": "#/$defs/finding" }
    },
    "summary": {
      "type": "object",
      "properties": {
        "total_findings": { "type": "integer", "minimum": 0 },
        "reportable": { "type": "integer", "minimum": 0 },
        "by_severity": {
          "type": "object",
          "properties": {
            "critical": { "type": "integer" },
            "high": { "type": "integer" },
            "medium": { "type": "integer" },
            "low": { "type": "integer" },
            "info": { "type": "integer" }
          }
        }
      }
    }
  },
  "$defs": {
    "finding": {
      "type": "object",
      "required": ["id", "title", "severity", "confidence", "locations", "evidence", "remediation"],
      "additionalProperties": true,
      "properties": {
        "id": { "type": "string", "pattern": "^F[0-9]+$" },
        "title": { "type": "string", "minLength": 1 },
        "severity": { "enum": ["critical", "high", "medium", "low"] },
        "confidence": { "enum": ["high", "medium", "low"] },
        "category": { "type": "array", "items": { "type": "string" } },
        "cwe": { "type": "string" },
        "weakness": { "type": "string" },
        "attacker": { "type": "string" },
        "controlled_input": { "type": "string" },
        "prerequisites": { "type": "array", "items": { "type": "string" } },
        "violated_invariant": { "type": "string" },
        "source_to_sink_path": { "type": "string" },
        "root_cause": { "type": "string" },
        "impact": { "type": "string" },
        "counterevidence": { "type": "string" },
        "remediation": { "type": "string", "minLength": 1 },
        "reportable": { "type": "boolean" },
        "status": {
          "enum": ["reportable", "reportable_with_gate", "informational", "defense_in_depth"]
        },
        "in_scope": { "type": "boolean" },
        "scope_basis": { "type": "string" },
        "gates": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["gate_id", "description"],
            "properties": {
              "gate_id": { "type": "string" },
              "description": { "type": "string" },
              "why_it_matters": { "type": "string" },
              "how_to_resolve": { "type": "string" },
              "counter_evidence_so_far": { "type": "string" }
            }
          }
        },
        "locations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["path"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "startLine": { "type": "integer", "minimum": 1 },
              "endLine": { "type": "integer", "minimum": 1 },
              "roles": {
                "type": "array",
                "items": {
                  "enum": [
                    "entrypoint", "root_control", "sink", "concrete_implementation",
                    "source", "control", "config", "caller", "test", "other"
                  ]
                }
              },
              "symbol": { "type": "string" },
              "detail": { "type": "string" }
            }
          }
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
