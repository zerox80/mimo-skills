{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mimo-security-scan/v1/coverage.json",
  "title": "mimo-security-scan/v1 coverage",
  "type": "object",
  "required": ["format", "fully_reviewed_paths", "complete"],
  "additionalProperties": true,
  "properties": {
    "format": { "const": "mimo-security-scan/v1" },
    "requested_inventory": {
      "oneOf": [
        { "type": "array", "items": { "type": "string" } },
        {
          "type": "object",
          "properties": {
            "generated_from": { "type": "string" },
            "file_count": { "type": "integer" },
            "path": { "type": "string" }
          }
        }
      ]
    },
    "fully_reviewed_paths": { "type": "array", "items": { "type": "string" } },
    "supporting_paths": { "type": "array", "items": { "type": "string" } },
    "remaining_paths": { "type": "array", "items": { "type": "string" } },
    "exclusions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "reason"],
        "properties": {
          "path": { "type": "string" },
          "reason": { "type": "string" }
        }
      }
    },
    "suppressed_candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "outcome"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "outcome": {
            "enum": ["suppressed", "not_applicable", "disproven", "disproven_as_reportable"]
          },
          "reason": { "type": "string" },
          "counterevidence": { "type": "string" },
          "was_drafted_as": { "type": "string" }
        }
      }
    },
    "deferred": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "why", "how_to_resolve"],
        "properties": {
          "id": { "type": "string", "pattern": "^DEF-" },
          "title": { "type": "string" },
          "why": { "type": "string" },
          "how_to_resolve": { "type": "string" }
        }
      }
    },
    "open_questions": { "type": "array", "items": { "type": "string" } },
    "complete": { "type": "boolean" }
  }
}
